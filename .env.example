# Mercado environment variables. Copy to `.env.local` (root, gitignored) and fill in.
# TESTNET ONLY: use throwaway keys funded from the Tempo Moderato faucet. Never put real-money keys here.

# --- Chain ---
TEMPO_CHAIN_ID=42431
# Optional override; the default comes from packages/shared/src/chain.ts
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# --- Accounts (each needs <ROLE>_PRIVATE_KEY and <ROLE>_ADDRESS) ---
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Signs EIP-712 CreditPool eligibility attestations (server-side only)
ATTESTATION_SIGNER_PRIVATE_KEY=
ATTESTATION_SIGNER_ADDRESS=
LP_PRIVATE_KEY=
LP_ADDRESS=
SENDER_PRIVATE_KEY=
SENDER_ADDRESS=
RECIPIENT_PRIVATE_KEY=
RECIPIENT_ADDRESS=
DRIVER_PRIVATE_KEY=
DRIVER_ADDRESS=
LENDER_PRIVATE_KEY=
LENDER_ADDRESS=
# MPP payment recipient for /api/bills/pay
MERCHANT_PRIVATE_KEY=
MERCHANT_ADDRESS=

# --- Demo journey script (scripts/demo-journey.ts) ---
# Base URL of the running Next.js app
MERCADO_API_URL=http://localhost:3000
