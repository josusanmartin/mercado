# Mercado environment variables. Copy to `.env.local` (repo root, gitignored) and fill in.
# TESTNET ONLY: throwaway keys funded from the Tempo Moderato faucet. Never put real-money keys here.

# --- Chain ---
TEMPO_CHAIN_ID=42431
# Optional override; the default comes from packages/shared/src/chain.ts
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# --- Accounts (each needs <ROLE>_PRIVATE_KEY and <ROLE>_ADDRESS) ---
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Signs EIP-712 CreditPool eligibility attestations (server-side only)
ATTESTATION_SIGNER_PRIVATE_KEY=
ATTESTATION_SIGNER_ADDRESS=
# Institution / LP (Mint)
LP_PRIVATE_KEY=
LP_ADDRESS=
# Remesas: US sender(s) and family recipients in Mexico
SENDER_PRIVATE_KEY=
SENDER_ADDRESS=
SENDER2_PRIVATE_KEY=
SENDER2_ADDRESS=
RECIPIENT_PRIVATE_KEY=
RECIPIENT_ADDRESS=
RECIPIENT_PAPA_PRIVATE_KEY=
RECIPIENT_PAPA_ADDRESS=
RECIPIENT_ANA_PRIVATE_KEY=
RECIPIENT_ANA_ADDRESS=
# Crédito driver, lender; Invest saver; Global/API partner
DRIVER_PRIVATE_KEY=
DRIVER_ADDRESS=
LENDER_PRIVATE_KEY=
LENDER_ADDRESS=
SAVER_PRIVATE_KEY=
SAVER_ADDRESS=
PARTNER_PRIVATE_KEY=
PARTNER_ADDRESS=
# MPP payment recipient + Mercado Card demo terminal ("Tienda Doña Mary")
MERCHANT_PRIVATE_KEY=
MERCHANT_ADDRESS=
# Fee sponsor for /api/sponsor (pays Tempo fees for Mercado calls only; testnet, rate-limited)
SPONSOR_PRIVATE_KEY=
SPONSOR_ADDRESS=
# Float that fulfills the SIMULATED card on-ramp with real OUSD (server-side only)
ONRAMP_FLOAT_PRIVATE_KEY=
ONRAMP_FLOAT_ADDRESS=

# --- Server ---
# HMAC key for MPP challenges (a random one is persisted in .data/ if unset)
MPP_SECRET_KEY=
# The card on-ramp is OFF unless this is set (pending security review)
ONRAMP_ENABLED=

# --- Protocol selection (crew/V2-SWITCH.md) ---
# Scripts/servers outside Next: v1 | v2. The app reads NEXT_PUBLIC_MERCADO_PROTOCOL from apps/web/.env.local.
MERCADO_PROTOCOL=v2

# --- Scripts ---
# Base URL of the running app (scripts/demo-journey*.ts, underwriter-agent.ts)
MERCADO_API_URL=http://localhost:3100
MERCADO_API_URL_V2=http://localhost:3100

# --- apps/web/.env.local (client; testnet demo keys only, labeled in the UI) ---
# NEXT_PUBLIC_MERCADO_PROTOCOL=v2
# NEXT_PUBLIC_DEMO_{LP,SENDER,RECIPIENT,DRIVER,LENDER,MERCHANT,SAVER,PARTNER}_{PRIVATE_KEY,ADDRESS}=
# NEXT_PUBLIC_DEMO_{PAPA,ANA}_ADDRESS=
# NEXT_PUBLIC_MERCHANT_ADDRESS=
# NEXT_PUBLIC_FEE_SPONSOR=
