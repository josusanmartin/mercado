#!/usr/bin/env bash
# One-command demo reset for rehearsals/recordings. Idempotent: safe to run before every take.
#   packages/contracts/script/demo-reset            (or: npm run demo:reset)
#   DEMO_RESET_SKIP_ORDERS=1 …                      skip archiving bill orders
# 1) archive bill orders (refuses if a payment is in flight, see api's archive-orders.mts)
# 2) on-chain reset (script/DemoReset.s.sol): oracle 20.00, desk unpaused + reseeded, pool cash ≥ 10k,
#    driver debt-free with 20 xMXN, sender/recipient xMXN swept to LP, LP ≥ 300%
# 3) print the state table
set -euo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
root="$(cd "$here/../.." && pwd)"
export PATH="$HOME/.foundry/bin:$PATH"
set -a; source "$root/.env.local"; set +a

if [ "${DEMO_RESET_SKIP_ORDERS:-0}" != "1" ]; then
  echo "== archiving bill orders"
  if ! (cd "$root" && npx tsx apps/web/lib/server/bills/archive-orders.mts); then
    echo "!! order archive refused (a payment may be in flight). Wait and retry, or DEMO_RESET_SKIP_ORDERS=1." >&2
    exit 1
  fi
fi

echo "== on-chain reset"
cd "$here"
# Normal nonces. If another DEPLOYER tx (oracle keeper, qa's J0 heal) lands mid-run, forge aborts with "nonce
# changed"; a fresh run re-simulates against current state (every step is idempotent), so we retry.
reset() {
  forge script script/DemoReset.s.sol --rpc-url moderato --broadcast --slow \
    --tempo.fee-token 0x20C0000000000000000000000000000000000001 2>&1 \
    | grep -vE "WARN|^\s*$" | grep -E "seeded|supplied|repaid|swept|DEMO_RESET|Error|error|revert|SUCCESS|No transactions" || true
}
ok=0
for attempt in 1 2 3; do
  out="$(reset)"; echo "$out"
  if grep -q "ONCHAIN EXECUTION COMPLETE & SUCCESSFUL" <<<"$out" || ! grep -qiE "error|revert" <<<"$out"; then ok=1; break; fi
  echo "== attempt $attempt failed; retrying"
done

echo "== state"
node "$here/script/demo-state.mjs"
[ "$ok" = 1 ] || { echo "!! demo reset did not complete" >&2; exit 1; }
