#!/usr/bin/env python3
"""#mercado — tiny file-backed IRC-style channel for the build crew.

  irc say "message"        post as $IRC_NICK (or -n NICK)
  irc unread               show messages since you last checked (marks them read)
  irc tail [N]             last N messages (default 40)
  irc view                 live, colored, human-readable view (for the tmux window)
  irc chat                 interactive prompt for a human (nick: $IRC_NICK or 'josu')
"""
import fcntl, os, sys, time, datetime, hashlib

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DIR = os.environ.get("IRC_DIR", os.path.join(ROOT, ".irc"))
LOG = os.path.join(DIR, "mercado.log")
CHAN = "#mercado"
os.makedirs(os.path.join(DIR, "cursors"), exist_ok=True)

def nick(args):
    if len(args) >= 2 and args[0] == "-n":
        return args[1], args[2:]
    return os.environ.get("IRC_NICK", "anon"), args

def post(who, text):
    text = text.strip()
    if not text:
        return
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with open(LOG, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        for line in text.splitlines():
            f.write(f"{ts}\t{who}\t{line.rstrip()}\n")
        fcntl.flock(f, fcntl.LOCK_UN)

def lines():
    if not os.path.exists(LOG):
        return []
    with open(LOG) as f:
        return f.read().splitlines()

def plain(l):
    try:
        ts, who, msg = l.split("\t", 2)
    except ValueError:
        return l
    return f"[{ts[11:16]}] <{who}> {msg}"

COLORS = [31, 32, 33, 34, 35, 36, 91, 92, 93, 94, 95, 96]
def color(l):
    try:
        ts, who, msg = l.split("\t", 2)
    except ValueError:
        return l
    if who == "*":
        return f"\033[90m{ts[11:19]}\033[0m \033[90m-!- {msg}\033[0m"
    c = COLORS[int(hashlib.md5(who.encode()).hexdigest(), 16) % len(COLORS)]
    hl = "\033[1m" if "@" in msg else ""
    return f"\033[90m{ts[11:19]}\033[0m \033[{c};1m{who:>12}\033[0m \033[90m│\033[0m {hl}{msg}\033[0m"

def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__); return
    cmd, rest = a[0], a[1:]
    who, rest = nick(rest)
    if cmd == "say":
        post(who, " ".join(rest) if rest else sys.stdin.read())
    elif cmd == "unread":
        cur = os.path.join(DIR, "cursors", who)
        n = int(open(cur).read() or 0) if os.path.exists(cur) else 0
        ls = lines()
        new = [l for l in ls[n:] if l.split("\t", 2)[1:2] != [who]]
        print("\n".join(plain(l) for l in new) if new else f"(no unread in {CHAN})")
        open(cur, "w").write(str(len(ls)))
    elif cmd == "tail":
        n = int(rest[0]) if rest else 40
        print("\n".join(plain(l) for l in lines()[-n:]))
    elif cmd == "view":
        print(f"\033[1m── {CHAN} ── Mercado build crew ──\033[0m")
        pos = 0
        while True:
            ls = lines()
            for l in ls[pos:]:
                print(color(l), flush=True)
            pos = len(ls)
            time.sleep(0.5)
    elif cmd == "chat":
        me = os.environ.get("IRC_NICK", "josu")
        print(f"talking in {CHAN} as <{me}>  (Ctrl-D to quit; use @nick to address an agent)")
        try:
            while True:
                post(me, input(f"[{me}] "))
        except (EOFError, KeyboardInterrupt):
            print()
    else:
        print(__doc__); sys.exit(1)

if __name__ == "__main__":
    main()
